# LLM Server (vLLM or llama.cpp)
LLM_URL=http://localhost:9999
LLM_MODEL=test-model
LLM_API_KEY=test-key
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30s
LLM_LOG_REQUESTS=false
LLM_LOG_RESPONSES=false

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=test-collection
QDRANT_DISTANCE=COSINE

# Knowledge base
KNOWLEDGE_BASE_DIR=classpath:knowledge-base

# RAG Pipeline
AI_RAG_RETRIEVAL_TOP_K=5
AI_RAG_RETRIEVAL_SIMILARITY_THRESHOLD=0.5
AI_RAG_MAX_CONTEXT_TOKENS=3000
AI_RAG_CHUNK_SIZE=800
AI_RAG_CHUNK_OVERLAP=150
AI_RAG_CHUNK_MAX_ITERATIONS=1000

# AI HTTP
AI_HTTP_CONNECT_TIMEOUT=5

# AI Memory
AI_MEMORY_MAX_MESSAGES=20

# Database
DB_URL=jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
DB_USERNAME=sa
DB_PASSWORD=
DB_POOL_MAX=5
DB_POOL_MIN=1

# Server
SERVER_PORT=8081

# JPA
JPA_DDL_AUTO=create-drop
SHOW_SQL=true
LOGGING_LEVEL=DEBUG
LOGGING_LEVEL_APACHE=DEBUG
LOGGING_LEVEL_HIBERNATE_POOL=WARN

# Flyway
FLYWAY_ENABLED=false

# Actuator
ACTUATOR_ENDPOINTS=health,info