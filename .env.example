# LLM Server (vLLM or llama.cpp)
LLM_URL=http://localhost:8000/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30s
LLM_LOG_REQUESTS=true
LLM_LOG_RESPONSES=true

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_documents
QDRANT_DISTANCE=COSINE

# Knowledge base
KNOWLEDGE_BASE_DIR=classpath:knowledge-base

# RAG Pipeline
AI_RAG_RETRIEVAL_TOP_K=5
AI_RAG_RETRIEVAL_SIMILARITY_THRESHOLD=0.5
AI_RAG_MAX_CONTEXT_TOKENS=3000
AI_RAG_CHUNK_SIZE=800
AI_RAG_CHUNK_OVERLAP=150
AI_RAG_CHUNK_MAX_ITERATIONS=1000

# AI HTTP
AI_HTTP_CONNECT_TIMEOUT=30

# AI Memory
AI_MEMORY_MAX_MESSAGES=20

# Database
DB_URL=jdbc:postgresql://localhost:5432/banking_platform
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_POOL_MAX=10
DB_POOL_MIN=5

# Server
SERVER_PORT=8080

# JPA
JPA_DDL_AUTO=update
SHOW_SQL=false
LOGGING_LEVEL=INFO
LOGGING_LEVEL_APACHE=DEBUG
LOGGING_LEVEL_HIBERNATE_POOL=WARN

# Actuator
ACTUATOR_ENDPOINTS=health,info